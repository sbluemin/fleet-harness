{
  "name": "@dotobokuri/fleet-desktop",
  "version": "0.7.2",
  "description": "Fleet Console Electron main-process host.",
  "private": true,
  "type": "module",
  "main": "dist/main.mjs",
  "engines": {
    "node": ">=22.12.0",
    "electron": ">=43.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @dotobokuri/fleet-console build && pnpm build && node scripts/launch-dev-desktop.mjs",
    "build": "tsup && node scripts/copy-entry-assets.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "package:dir": "pnpm build && electron-builder --dir --publish never",
    "package:unsigned": "pnpm build && electron-builder --publish never",
    "prepackage:release": "node scripts/verify-packaged-app.mjs --preflight",
    "package:release": "pnpm build && electron-builder --publish never --config.forceCodeSigning=true --config.mac.notarize=true",
    "postpackage:release": "node scripts/verify-packaged-app.mjs --release",
    "package": "pnpm package:release",
    "verify:package": "node scripts/verify-packaged-app.mjs"
  },
  "devDependencies": {
    "@dotobokuri/core-process": "workspace:*",
    "@electron/asar": "3.4.1",
    "@dotobokuri/fleet-console": "workspace:*",
    "@fleet-console/access-protocol": "workspace:*",
    "@fleet-console/desktop-protocol": "workspace:*",
    "@electron/fuses": "2.1.3",
    "electron": "43.1.0",
    "electron-builder": "26.15.3",
    "tsup": "8.5.1",
    "typescript": "6.0.2",
    "vitest": "4.1.10"
  }
}

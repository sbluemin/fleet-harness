{
  "name": "@dotobokuri/fleet-wiki-ui",
  "version": "1.0.0",
  "description": "Fleet Wiki UI — standalone web surface and per-user local daemon for browsing Fleet Wiki workspaces.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sbluemin/fleet-harness.git",
    "directory": "runtime/fleet-wiki-ui"
  },
  "homepage": "https://github.com/sbluemin/fleet-harness#readme",
  "bugs": {
    "url": "https://github.com/sbluemin/fleet-harness/issues"
  },
  "private": true,
  "type": "module",
  "main": "./dist/cli.mjs",
  "types": "./dist/cli.d.ts",
  "bin": {
    "fleet-wiki": "./dist/cli.mjs"
  },
  "exports": {
    "./cli": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.mjs"
    },
    "./dist/cli.mjs": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.mjs"
    }
  },
  "files": [
    "dist",
    "AGENTS.md",
    "README.md"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsup && vite build --config client/vite.config.ts",
    "dev:client": "vite --config client/vite.config.ts",
    "publish:npm": "node ../../scripts/publish-fleet-wiki-ui.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p client/tsconfig.json"
  },
  "dependencies": {
    "@dotobokuri/fleet-style": "workspace:*",
    "@dotobokuri/fleet-wiki": "workspace:*",
    "dompurify": "^3.4.2",
    "highlight.js": "^11.11.1",
    "marked": "^16.4.1",
    "mermaid": "^11.0.0"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "^5.2.9",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/manrope": "^5.2.8",
    "@types/node": "^24.9.1",
    "jsdom": "^29.1.1",
    "tsup": "^8.5.0",
    "typescript": "^6.0.2",
    "vite": "^7.2.7",
    "vitest": "^3.2.4"
  }
}

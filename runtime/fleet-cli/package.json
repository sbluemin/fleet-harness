{
  "name": "@dotobokuri/fleet-cli",
  "version": "1.50.1",
  "description": "Fleet CLI — a thin native launcher for gateway-doctrine Claude Code.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sbluemin/fleet-harness.git",
    "directory": "runtime/fleet-cli"
  },
  "homepage": "https://github.com/sbluemin/fleet-harness#readme",
  "bugs": {
    "url": "https://github.com/sbluemin/fleet-harness/issues"
  },
  "private": true,
  "type": "module",
  "preferGlobal": true,
  "bin": {
    "fleet": "./bin/fleet"
  },
  "files": [
    "dist",
    "bin",
    "postinstall.mjs",
    "README.md"
  ],
  "scripts": {
    "boundary:guard": "node ../../scripts/guard-fleet-agent-boundary.mjs",
    "build": "pnpm boundary:guard && tsc",
    "build:bundle": "tsup",
    "typecheck": "tsc --noEmit",
    "publish:npm": "node ../../scripts/publish-fleet-cli.mjs",
    "dev": "tsx src/index.ts",
    "fleet": "tsx src/index.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@clack/prompts": "1.4.0",
    "@dotobokuri/core-agent": "workspace:*",
    "@dotobokuri/core-ai-gateway": "workspace:*",
    "@dotobokuri/core-infra": "workspace:*",
    "@dotobokuri/fleet-admiral": "workspace:*",
    "@dotobokuri/fleet-wiki": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.3",
    "typescript": "^6.0.2",
    "vitest": "^4.0.13"
  }
}

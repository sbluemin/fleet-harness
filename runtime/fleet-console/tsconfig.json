{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "isolatedModules": true,
    "ignoreDeprecations": "6.0",
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@fleet-console/agent-runtime": [
        "../../runtime/fleet-console/foundation/agent-runtime/dist/index.d.ts"
      ],
      "@fleet-console/infra": [
        "../../runtime/fleet-console/foundation/infra/dist/index.d.ts"
      ],
      "@fleet-console/ai-gateway": [
        "../../runtime/fleet-console/features/ai-gateway/runtime/dist/index.d.ts"
      ],
      "@fleet-console/protocol/desktop": [
        "protocol/desktop/index.ts"
      ]
    }
  },
  "include": [
    "cli/**/*.ts",
    "core/host/**/*.ts",
    "core/client/src/vite-env.d.ts",
    "core/client/src/virtual-fleet-plugins.d.ts",
    "tests/**/*.ts",
    "tsup.config.ts",
    "vitest.config.ts",
    "features/*/host/**/*.ts",
    "features/updates/runtime/**/*.ts"
  ]
}

{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "isolatedModules": true,
    "ignoreDeprecations": "6.0",
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@dotobokuri/core-agent": ["../../packages/core-agent/dist/index.d.ts"],
      "@dotobokuri/core-unified-agent": ["../../packages/core-unified-agent/dist/index.d.ts"],
      "@dotobokuri/fleet-admiral": ["../../packages/fleet-admiral/dist/index.d.ts"],
      "@dotobokuri/core-infra": ["../../packages/core-infra/dist/index.d.ts"],
      "@dotobokuri/fleet-wiki": ["../../packages/fleet-wiki/dist/index.d.ts"],
      "@fleet-console/desktop-protocol": ["desktop-protocol/index.ts"]
    }
  },
  "include": [
    "core/host/**/*.ts",
    "core/client/src/vite-env.d.ts",
    "core/client/src/virtual-fleet-plugins.d.ts",
    "tests/**/*.ts",
    "tsup.config.ts",
    "vitest.config.ts"
  ]
}

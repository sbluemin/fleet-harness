    "@types/react-dom": "^19.0.0",
    "jsdom": "^27.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^6.0.2",
    "vitest": "^4.0.13"
  },
  "scripts": {
    "test": "vitest run --environment jsdom",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }

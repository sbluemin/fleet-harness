{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "ignoreDeprecations": "6.0",
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["vite/client"],
    "baseUrl": "../..",
    "paths": {
      "@xterm/addon-fit": ["node_modules/@xterm/addon-fit"],
      "@xterm/addon-unicode11": ["node_modules/@xterm/addon-unicode11"],
      "@xterm/addon-webgl": ["node_modules/@xterm/addon-webgl"],
      "@xterm/xterm": ["node_modules/@xterm/xterm"],
      "react": ["node_modules/@types/react/index.d.ts"],
      "react/jsx-runtime": ["node_modules/@types/react/jsx-runtime.d.ts"],
      "virtual:fleet-plugins": ["core/client/src/virtual-fleet-plugins.d.ts"]
    },
    "typeRoots": ["node_modules/@types"]
  },
  "include": ["src", "vite.config.ts"]
}

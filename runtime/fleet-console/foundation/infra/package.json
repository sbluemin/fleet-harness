{
  "name": "@fleet-console/infra",
  "version": "1.255.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sbluemin/fleet-harness.git",
    "directory": "runtime/fleet-console/foundation/infra"
  },
  "private": true,
  "author": "sbluemin",
  "type": "module",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "CLAUDE.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly --noEmit false -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --incremental -p tsconfig.json"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./data-dir": {
      "types": "./dist/data-dir/paths.d.ts",
      "import": "./dist/data-dir/paths.js",
      "require": "./dist/data-dir/paths.cjs"
    },
    "./fs-store": {
      "types": "./dist/fs-store/index.d.ts",
      "import": "./dist/fs-store.js",
      "require": "./dist/fs-store.cjs"
    },
    "./workspace-dir": {
      "types": "./dist/workspace-dir/workspace-dir.d.ts",
      "import": "./dist/workspace-dir/workspace-dir.js",
      "require": "./dist/workspace-dir/workspace-dir.cjs"
    },
    "./http/routing": {
      "types": "./dist/http/routing.d.ts",
      "import": "./dist/http/routing.js",
      "require": "./dist/http/routing.cjs"
    },
    "./http/catalog": {
      "types": "./dist/http/catalog.d.ts",
      "import": "./dist/http/catalog.js",
      "require": "./dist/http/catalog.cjs"
    },
    "./http/client-ports": {
      "types": "./dist/http/client-ports.d.ts",
      "import": "./dist/http/client-ports.js",
      "require": "./dist/http/client-ports.cjs"
    },
    "./http/host-ports": {
      "types": "./dist/http/host-ports.d.ts",
      "import": "./dist/http/host-ports.js",
      "require": "./dist/http/host-ports.cjs"
    },
    "./http/mcp-transport": {
      "types": "./dist/http/mcp-transport.d.ts",
      "import": "./dist/http/mcp-transport.js",
      "require": "./dist/http/mcp-transport.cjs"
    }
  },
  "typesVersions": {
    "*": {
      "data-dir": [
        "dist/data-dir/paths.d.ts"
      ],
      "fs-store": [
        "dist/fs-store/index.d.ts"
      ],
      "workspace-dir": [
        "dist/workspace-dir/workspace-dir.d.ts"
      ],
      "http/routing": [
        "dist/http/routing.d.ts"
      ],
      "http/catalog": [
        "dist/http/catalog.d.ts"
      ],
      "http/client-ports": [
        "dist/http/client-ports.d.ts"
      ],
      "http/host-ports": [
        "dist/http/host-ports.d.ts"
      ],
      "http/mcp-transport": [
        "dist/http/mcp-transport.d.ts"
      ]
    }
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^24.10.0",
    "tsup": "^8.5.0",
    "typescript": "^6.0.2",
    "vitest": "^4.0.13"
  }
}

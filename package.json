{
  "name": "fleet-harness",
  "version": "0.21.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sbluemin/fleet-harness.git"
  },
  "private": true,
  "author": "sbluemin",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "pnpm -r build",
    "fleetd": "pnpm --filter @sbluemin/fleet-unified-agent build && pnpm --filter @sbluemin/fleet-agent dev",
    "postinstall": "pnpm -r build"
  },
  "bin": {
    "fleetd": "./packages/fleet-agent/bin/fleetd.mjs",
    "fleet-wiki": "./packages/fleet-wiki-web/dist/cli.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typebox": "^1.1.24",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.119",
    "undici": "^7"
  }
}

{
  "name": "fleet-harness",
  "version": "1.6.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sbluemin/fleet-harness.git"
  },
  "private": true,
  "author": "sbluemin",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "pnpm -r build",
    "check:core-boundary": "node scripts/check-core-boundary.mjs",
    "check:protocol-sync": "node scripts/check-protocol-sync.mjs",
    "fleet": "pnpm --filter @dotobokuri/core-unified-agent build && pnpm --filter @dotobokuri/fleet-cli dev",
    "fleet-console": "pnpm --filter @dotobokuri/fleet-console cli",
    "postinstall": "node scripts/fix-node-pty-spawn-helper.mjs && node scripts/generate-fleet-admiral-assets.mjs && pnpm -r build"
  },
  "bin": {
    "fleet": "./runtime/fleet-cli/bin/fleet"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^6.0.2"
  }
}

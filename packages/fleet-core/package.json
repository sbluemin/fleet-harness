{
  "name": "@sbluemin/fleet-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "api",
    "README.md",
    "AGENTS.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./admiral": {
      "types": "./dist/admiral.d.ts",
      "import": "./dist/admiral.js",
      "require": "./dist/admiral.cjs"
    },
    "./admiralty": {
      "types": "./dist/admiralty.d.ts",
      "import": "./dist/admiralty.js",
      "require": "./dist/admiralty.cjs"
    },
    "./metaphor": {
      "types": "./dist/metaphor.d.ts",
      "import": "./dist/metaphor.js",
      "require": "./dist/metaphor.cjs"
    },
    "./infra": {
      "types": "./dist/infra.d.ts",
      "import": "./dist/infra.js",
      "require": "./dist/infra.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@sbluemin/unified-agent": "workspace:*",
    "@sinclair/typebox": "^0.34.41"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "tsup": "^8.5.0",
    "typescript": "^6.0.2",
    "vitest": "^4.0.13"
  }
}

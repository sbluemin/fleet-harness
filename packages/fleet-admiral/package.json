{
  "name": "@dotobokuri/fleet-admiral",
  "version": "1.80.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sbluemin/fleet-harness.git",
    "directory": "packages/fleet-admiral"
  },
  "private": true,
  "author": "sbluemin",
  "type": "module",
  "files": [
    "dist",
    "CLAUDE.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "pnpm generate && tsup",
    "generate": "node ../../scripts/generate-fleet-admiral-assets.mjs",
    "prepare": "pnpm generate",
    "prepack": "pnpm generate",
    "test": "pnpm generate && vitest run --passWithNoTests",
    "typecheck": "pnpm generate && tsc --noEmit -p tsconfig.json"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "dependencies": {
    "@dotobokuri/core-agent": "workspace:*",
    "@dotobokuri/core-ai-gateway": "workspace:*",
    "@dotobokuri/core-infra": "workspace:*",
    "@dotobokuri/core-process": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "tsup": "^8.5.0",
    "typescript": "^6.0.2",
    "vitest": "^4.0.13"
  }
}

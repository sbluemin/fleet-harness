{
  "name": "@dotobokuri/fleet-agent",
  "version": "0.21.0",
  "private": true,
  "type": "module",
  "bin": {
    "fleet": "./bin/fleet"
  },
  "files": [
    "dist",
    "bin",
    "postinstall.mjs"
  ],
  "scripts": {
    "boundary:guard": "node ../../scripts/guard-fleet-agent-boundary.mjs",
    "build": "pnpm boundary:guard && tsc",
    "build:bundle": "tsup",
    "publish:npm": "node ../../scripts/publish-fleet-agent.mjs",
    "dev": "tsx src/index.ts",
    "fleet": "tsx src/index.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@clack/prompts": "1.4.0",
    "@dotobokuri/fleet-carriers": "workspace:*",
    "@dotobokuri/fleet-infra": "workspace:*",
    "@dotobokuri/fleet-mcp-server": "workspace:*",
    "@dotobokuri/fleet-tui": "workspace:../fleet-tui",
    "@dotobokuri/fleet-wiki": "workspace:*",
    "@dotobokuri/fleet-wiki-web": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.3",
    "typescript": "^6.0.2",
    "vitest": "^4.0.13"
  }
}

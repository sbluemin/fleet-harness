{
  "name": "@dotobokuri/core-agent",
  "version": "1.73.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sbluemin/fleet-harness.git",
    "directory": "packages/core-agent"
  },
  "private": true,
  "author": "sbluemin",
  "type": "module",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "CLAUDE.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly --noEmit false -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./claude": {
      "types": "./dist/claude/index.d.ts",
      "import": "./dist/claude/index.js",
      "require": "./dist/claude/index.cjs"
    }
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.212",
    "@dotobokuri/core-ai-gateway": "workspace:*",
    "@dotobokuri/core-process": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "tsup": "^8.5.0",
    "typescript": "^6.0.2",
    "vitest": "^4.0.13",
    "zod": "^4.3.6"
  }
}

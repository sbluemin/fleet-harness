{
	"compilerOptions": {
		"target": "ES2022",
		"module": "Node16",
		"lib": ["ES2022"],
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"inlineSources": true,
		"inlineSourceMap": false,
		"moduleResolution": "Node16",
		"resolveJsonModule": true,
		"allowImportingTsExtensions": false,
		"experimentalDecorators": true,
		"emitDecoratorMetadata": true,
		"useDefineForClassFields": false,
		"types": ["node"],
		"paths": {
			"@sbluemin/fleet-ai": ["./packages/ai/src/index.ts"],
			"@sbluemin/fleet-ai/oauth": ["./packages/ai/src/oauth.ts"],
			"@sbluemin/fleet-ai/*": ["./packages/ai/src/*.ts", "./packages/ai/src/providers/*.ts"],
			"@sbluemin/fleet-agent-core": ["./packages/agent/src/index.ts"],
			"@sbluemin/fleet-agent-core/*": ["./packages/agent/src/*"],
			"@sbluemin/fleet-coding-agent": ["./packages/coding-agent/src/index.ts"],
			"@sbluemin/fleet-coding-agent/hooks": ["./packages/coding-agent/src/core/hooks/index.ts"],
			"@sbluemin/fleet-coding-agent/*": ["./packages/coding-agent/src/*"],
			"@sbluemin/fleet-unified-agent": ["./packages/unified\u002dagent/src/index.ts"],
			"@sbluemin/fleet-unified-agent/*": ["./packages/unified\u002dagent/src/*"],
			"@sbluemin/fleet-tui": ["./packages/tui/src/index.ts"],
			"@sbluemin/fleet-tui/*": ["./packages/tui/src/*"]
		}
	}
}

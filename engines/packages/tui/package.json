{
	"name": "@sbluemin/fleet-tui",
	"version": "0.18.3",
	"description": "Terminal User Interface library with differential rendering for efficient text-based applications",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sbluemin/fleet-harness.git",
		"directory": "engines/packages/tui"
	},
	"type": "module",
	"main": "dist/index.js",
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json --target ES2024 --lib ES2024",
		"dev": "tsc -p tsconfig.build.json --target ES2024 --lib ES2024 --watch --preserveWatchOutput",
		"test": "node --test --import tsx test/*.test.ts",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"files": [
		"dist/**/*",
		"README.md"
	],
	"keywords": [
		"tui",
		"terminal",
		"ui",
		"text-editor",
		"differential-rendering",
		"typescript",
		"cli"
	],
	"author": "sbluemin",
	"license": "MIT",
	"engines": {
		"node": ">=20.0.0"
	},
	"types": "./dist/index.d.ts",
	"dependencies": {
		"@types/mime-types": "^2.1.4",
		"chalk": "^5.5.0",
		"get-east-asian-width": "^1.3.0",
		"marked": "^15.0.12",
		"mime-types": "^3.0.1"
	},
	"optionalDependencies": {
		"koffi": "^2.9.0"
	},
	"devDependencies": {
		"@xterm/headless": "^5.5.0",
		"@xterm/xterm": "^5.5.0"
	}
}

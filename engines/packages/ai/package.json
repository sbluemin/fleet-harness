{
	"name": "@sbluemin/fleet-ai",
	"version": "0.18.2",
	"description": "Core LLM abstraction layer with explicit provider registration",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sbluemin/fleet-harness.git",
		"directory": "engines/packages/ai"
	},
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./oauth": {
			"types": "./dist/oauth.d.ts",
			"import": "./dist/oauth.js"
		}
	},
	"bin": {
		"pi-ai": "./dist/cli.js"
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json --target ES2024 --lib ES2024",
		"dev": "tsc -p tsconfig.build.json --target ES2024 --lib ES2024 --watch --preserveWatchOutput",
		"dev:tsc": "tsc -p tsconfig.build.json --target ES2024 --lib ES2024 --watch --preserveWatchOutput",
		"test": "vitest --run",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"dependencies": {
		"chalk": "^5.6.2",
		"partial-json": "^0.1.7",
		"typebox": "^1.1.24",
		"undici": "^7.19.1",
		"zod-to-json-schema": "^3.24.6"
	},
	"keywords": [
		"ai",
		"llm",
		"unified",
		"api"
	],
	"author": "sbluemin",
	"license": "MIT",
	"engines": {
		"node": ">=20.0.0"
	},
	"devDependencies": {
		"@types/node": "^24.3.0",
		"canvas": "^3.2.0",
		"vitest": "^3.2.4"
	}
}

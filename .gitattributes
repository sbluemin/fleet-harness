# Windows에서 기여할 때 CRLF가 섞여 러너의 bash(워크플로 run: 블록)나 Swift 소스가
# 깨지는 것을 막는다. 저장소의 기존 파일은 모두 LF이므로 이미 LF인 파일에는 변화가 없다.
*.swift    text eol=lf
*.podspec  text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.mjs      text eol=lf
*.ts       text eol=lf
*.tsx      text eol=lf
*.json     text eol=lf
*.gitignore text eol=lf
